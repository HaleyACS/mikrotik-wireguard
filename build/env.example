# Copy this file to build/.env before running Docker Compose.
# Keep build/.env out of Git because it contains the RouterOS password.

MIKROTIK_WIREGUARD_IMAGE=mikrotik-wireguard:local
HTTP_PORT=8080

# RouterOS management/API connection
MIKROTIK_HOST=10.0.0.254
MIKROTIK_USERNAME=wgapi
MIKROTIK_PASSWORD='CHANGE_ME'
MIKROTIK_API_MODE=rest
MIKROTIK_SSL_VERIFY=false
MIKROTIK_INTERFACE=wireguard

# WireGuard network
WIREGUARD_SUBNET=10.0.1.0/24
WIREGUARD_SERVER_IP=10.0.1.1
CLIENT_ENDPOINT=wireguard.server.tld:13231
CLIENT_ALLOWED_IPS='10.0.1.0/24, 10.0.0.0/24'

# Multiple DNS servers are comma-separated for local Compose testing.
CLIENT_DNS='10.0.0.1, 1.1.1.1'
CLIENT_EXPORT_METADATA=true

# Optional application settings
MIKROTIK_LANG=en
EXPORT_MODE=rsc
REFRESH_INTERVAL=30
HANDSHAKE_TIMEOUT=5
PAGE_SIZE=50
SHOW_DNAT_COLUMN=false
SHOW_TRAFFIC_COLUMN=true
DNAT_BASE=30000
DNAT_MULTIPLIER=1000

# Native API settings (used only when MIKROTIK_API_MODE=native)
MIKROTIK_NATIVE_PORT=8728
MIKROTIK_NATIVE_TLS=false
